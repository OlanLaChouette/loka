PORT=4100
NODE_ENV=development

# Base de données PostgreSQL (ou DATABASE_URL en production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loka
DB_USER=postgres
DB_PASSWORD=
# Compte limité utilisé par l'application (créé par npm run db:creer)
DB_APP_USER=loka_app
DB_APP_PASSWORD=

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Adresse du site (CORS)
FRONTEND_URL=http://localhost:5174
